ENVIRONMENT=DEV
FLASK_DEBUG=false
SECRET_KEY=CAMBIAR_POR_UN_VALOR_ALEATORIO

DEV_DATABASE_URI=postgresql+psycopg2://postgres:password@localhost:5432/api_ia_utm
PROD_DATABASE_URI=
AUTO_CREATE_TABLES=true

JWT_ALGORITHM=RS256
JWT_PRIVATE_KEY_PATH=./secrets/jwt-private.pem
JWT_PUBLIC_KEY_PATH=./secrets/jwt-public.pem
JWT_ACCESS_TOKEN_MINUTES=60

CHROMA_PATH=./chroma_db
COLLECTION_NAME=utm_documents
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=deepseek-r1:8b
EMBEDDING_MODEL=nomic-embed-text
RAG_SCORE_THRESHOLD=0.8
RAG_MAX_CHARS=8000
RAG_MAX_QUESTION_LENGTH=1000

UPLOAD_FOLDER=./uploads
MAX_UPLOAD_MB=20
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
RATELIMIT_STORAGE_URI=memory://
RATELIMIT_ENABLED=true
